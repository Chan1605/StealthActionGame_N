  m_EditorClassIdentifier: Assembly-CSharp::SubtitleTrigger
  lookSubtitles:
  - subtitleText: "\uC544\uBB34\uB9AC \uC0DD\uAC01\uD574\uBD10\uB3C4 \uC774 \uACF3\uC5D0\uC11C
      \uC218\uC0C1\uD55C \uC77C\uC774 \uBC8C\uC5B4\uC9C0\uACE0 \uC788\uC5B4."
    audioEvent:
      Guid:
        Data1: 713545362
        Data2: 1164445543
        Data3: -1204132979
        Data4: -840279275
      Path: event:/Area_1/Player_Day_Start_01_It_Really_Does
    duration: 3
    isObjectSound: 0
  - subtitleText: "\uADF8 \uBE44\uBA85\uC740 \uC544\uBB34\uB9AC \uBD10\uB3C4 \uB0B4
      \uC606\uBC29\uC5D0 \uC788\uB358 \uB140\uC11D\uC758 \uBAA9\uC18C\uB9AC\uC600\uC5B4."
    audioEvent:
      Guid:
        Data1: -1416948461
        Data2: 1307693494
        Data3: 413851016
        Data4: 1933088249
      Path: event:/Area_1/Player_Day_Start_02_That_Scream_Was
    duration: 3
    isObjectSound: 0
  - subtitleText: "\uC548 \uBCF4\uC778\uC9C0 \uBA70\uCE60 \uB418\uC11C \uC774\uAC10\uC774\uB77C\uACE0\uB9CC
      \uC0DD\uAC01\uD588\uB294\uB370, \uC544\uB2C8\uC5C8\uB098 \uBCF4\uAD70."
