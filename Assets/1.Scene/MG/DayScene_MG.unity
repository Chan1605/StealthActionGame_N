  - subtitleText: "\uADF8\uB807\uB2E4\uB294 \uAC74, \uC774\uACF3\uC744 \uD0C8\uCD9C\uD574\uC57C\uACA0\uC5B4.
      \uCD5C\uB300\uD55C \uBE68\uB9AC"
