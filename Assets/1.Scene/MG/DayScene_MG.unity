        Data4: -1549732754
      Path: event:/Area_1/Player_Day_Start_03_I_Thought_He
    duration: 4
    isObjectSound: 0
  - subtitleText: "\uADF8\uB807\uB2E4\uB294 \uAC74 \uC800 \uBE44\uBA85\uC774 \uB0B4
      \uBE44\uBA85\uC774 \uB420 \uB0A0\uB3C4 \uBA40\uC9C0 \uC54A\uC558\uB2E4\uB294
      \uB9D0\uC774\uACA0\uC9C0."
